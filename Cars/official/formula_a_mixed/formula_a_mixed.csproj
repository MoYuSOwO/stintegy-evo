<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game's own car, built as a pack like any other: it references Core
    and nothing else, and its assembly goes into its folder under data/,
    where the game finds it the way it finds anyone's.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>official.formula_a_mixed</AssemblyName>
    <RootNamespace>Official.FormulaAMixed</RootNamespace>
    <OutDir>$(MSBuildThisFileDirectory)../../../data/official/cars/formula_a_mixed/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core is the game's: the pack is built against it, never ships it. -->
    <ProjectReference Include="../../../Core/StintegyEVO.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
