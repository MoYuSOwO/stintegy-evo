<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Times the lane driver's decision, so that a change to the planner can be
    judged on cost as well as on lap time. Not part of the game: run it from
    the repository root against a baked table.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>lane-bench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../StintegyEVO.Drivers.csproj" />
    <ProjectReference Include="../../../Core/StintegyEVO.Core.csproj" />
    <ProjectReference Include="../../../mods/official/official.csproj" />
  </ItemGroup>
</Project>
