<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The game's own chassis, built as a pack like any other: it references
    Core and nothing else, and its assembly goes into its folder under data/,
    where the game finds it for every car that names it in its car.json.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>official.single_track</AssemblyName>
    <RootNamespace>Official.SingleTrack</RootNamespace>
    <OutDir>$(MSBuildThisFileDirectory)../../../data/official/chassis/single_track/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <InternalsVisibleTo Include="official.single_track.Tests" />
    <InternalsVisibleTo Include="StintegyEVO.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is the game's: the pack is built against it, never ships it. -->
    <ProjectReference Include="../../../Core/StintegyEVO.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
