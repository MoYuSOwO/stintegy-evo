+using System.Text.Json;
+using StintegyEVO.Core.Cars;
+using StintegyEVO.Core.Drivers;
+using StintegyEVO.Core.Drivers.Learned;
+using StintegyEVO.TrainingHost.Environment;
+
+namespace StintegyEVO.TrainingHost;
+
+internal static class DiagnosticTiming
+{
+    public static int Run()
+    {
+        var env = new DirectDriveDuelEnvironment(solo:true);
+        var obs = new float[DirectDriveObservation.ObservationSize];
+        env.ResetScenario("speedway", 1, 500, 20, 50, obs);
+        var wrapper = new RecordingDriver(env.Ego.Driver);
+        env.Ego.Driver = wrapper;
+        for (int i=0;i<4;i++)
+        {
+            float command = i%2==0 ? 1f : -1f;
+            wrapper.Frames.Clear();
+            float before=env.Ego.State.Speed;
+            var result=env.Step(new float[]{0,command},obs);
+            Console.WriteLine(JsonSerializer.Serialize(new {
+                step=i,command,before,after=env.Ego.State.Speed,
+                returnedSpeed=obs[DirectDriveObservation.EgoOffset]*100f,
+                returnedLastAction=obs[DirectDriveObservation.EgoOffset+11],
+                reward=result.Reward, frames=wrapper.Frames
+            }));
+        }
+        var first = new DirectDriveDuelEnvironment(solo:true);
+        var second = new DirectDriveDuelEnvironment(solo:true);
+        var oa = new float[452]; var ob = new float[452];
+        first.ResetScenario("speedway",1,500,20,50,oa);
+        second.ResetScenario("speedway",1,500,20,50,ob);
+        first.Step(new float[]{0,1},oa);
+        second.Step(new float[]{0,1},ob);
+        var ra=first.Step(new float[]{0,1},oa);
+        var rb=second.Step(new float[]{0,-1},ob);
+        Console.WriteLine(JsonSerializer.Serialize(new {
+            test="opposite_current_actions",
+            sameReturnedObservation=oa.SequenceEqual(ob),
+            maxObservationDifference=oa.Zip(ob,(a,b)=>Math.Abs(a-b)).Max(),
+            positiveActionPostSpeed=first.Ego.State.Speed,
+            negativeActionPostSpeed=second.Ego.State.Speed,
+            positiveReward=ra.Reward,negativeReward=rb.Reward
+        }));
+        return 0;
+    }
+
+    private sealed class RecordingDriver(IRaceDriver inner) : IRaceDriver
+    {
+        public List<object> Frames {get;} = new();
+        public float TireEnergyEfficiency=>inner.TireEnergyEfficiency;
+        public float CorneringEfficiency=>inner.CorneringEfficiency;
+        public float LimitSettleUse=>inner.LimitSettleUse;
+        public DriverInput GetControl(in RaceDriverFrameContext context,float dt)
+        {
+            var input=inner.GetControl(in context,dt);
+            Frames.Add(new {time=context.RaceTimeSeconds,dt,accel=input.DesiredAccel});
+            return input;
+        }
+    }
+}
