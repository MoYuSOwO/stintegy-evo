<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <!-- Editor runs load Debug output, but simulation hot paths must remain optimized. -->
    <SimulationConfiguration Condition="'$(SimulationConfiguration)' == ''">Release</SimulationConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Core/StintegyEVO.Core.csproj" AdditionalProperties="Configuration=$(SimulationConfiguration)" />
    <ProjectReference Include="Drivers/StintegyEVO.Drivers.csproj" AdditionalProperties="Configuration=$(SimulationConfiguration)" />
    <!-- The game's own car is a pack the game loads from data/ like anyone's:
         built with the game, never referenced by it. -->
    <ProjectReference Include="Cars/official/formula_a_mixed/formula_a_mixed.csproj" AdditionalProperties="Configuration=$(SimulationConfiguration)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".godot/**/*.cs" />
    <Compile Remove="Core/**/*.cs" />
    <Compile Remove="Training/**/*.cs" />
    <Compile Remove="Drivers/**/*.cs" />
    <!-- Car packs are their own assemblies. -->
    <Compile Remove="Cars/**/*.cs" />
    <!-- The circuit tool writes Circuits/ offline; it is not part of the game. -->
    <Compile Remove="Tools/Circuits/**/*.cs" />
    <!-- Test controllers/fixtures never ship in an ordinary game build. -->
    <Compile Remove="Tools/Tests/**/*.cs" />
    <Compile Include="Tools/Tests/**/*.cs" Condition="'$(PresentationSmoke)' == 'true'" />
    <!-- Nested worktrees are separate checkouts, not game source files. -->
    <Compile Remove=".worktrees/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
  </ItemGroup>
</Project>
