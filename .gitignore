# Godot 4+ specific ignores
.godot/
.godot/*
/android/
.vscode/
.idea/
.tmp/
.worktrees/
gdunit4_testadapter_v5/
.DS_Store
**/bin/
**/obj/

# Python virtual environments.
.venv/
__pycache__/
*.pyc

# TUM 3D line-bake scratch (raw exports, CasADi work).
Drivers/Bake/work/
Drivers/Bake/raw/

# The historical training tree remains available in Git history, but is not
# part of the master product boundary and must not be re-added accidentally.
/Training/

# Learned-policy/model resources belong to external integrations.
*.nn
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.npz
*.npy

# Local verification output.
TestResults/
*.trx
*.coverage
private/
# Godot imports a CSV under res:// as a translation table; the track data is not one.
Drivers/Tracks/*.translation
Drivers/Tracks/*.csv.import
*.csproj.old
# Drawn from OpenStreetMap for a circuit kept out of the repository.
Drivers/Bake/daytona_road_course_osm.png*

# A mod's code is built into its folder under mods/; the build output is
# not source. Its mod.json, data and models are.
/mods/**/*.dll
/mods/**/*.pdb
/mods/**/*.runtimeconfig.json
/mods/**/*.deps.json
