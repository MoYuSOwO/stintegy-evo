# Godot 4+ specific ignores
.godot/
.godot/*
/android/
.vscode/
.idea/
.tmp/
.worktrees/
gdunit4_testadapter_v5/
.DS_Store
**/bin/
**/obj/

# Python virtual environments.
.venv/

# The historical training tree remains available in Git history, but is not
# part of the master product boundary and must not be re-added accidentally.
/Training/

# Learned-policy/model resources belong to external integrations.
*.nn
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.npz
*.npy

# Local verification output.
TestResults/
*.trx
*.coverage

# A mod's code is built into its folder under mods/; the build output is
# not source. Its mod.json, data and models are.
/mods/**/*.dll
/mods/**/*.pdb
/mods/**/*.runtimeconfig.json
/mods/**/*.deps.json
