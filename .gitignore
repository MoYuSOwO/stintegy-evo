# Godot 4+ specific ignores
.godot/
.godot/*
/android/
.vscode/
.idea/
.tmp/
.worktrees/
gdunit4_testadapter_v5/
.DS_Store
**/bin/
**/obj/

# Python virtual environments.
.venv/

# era/world-v3 carries the training tree; master does not. Live run logs
# stay out of `git add -A`; finished rounds are archived with `git add -f`.
Training/python/*.log

# Learned-policy/model resources belong to external integrations.
*.nn
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.tflite
*.npz
*.npy

# Local verification output.
TestResults/
*.trx
*.coverage
