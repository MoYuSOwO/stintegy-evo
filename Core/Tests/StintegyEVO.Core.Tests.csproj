<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>StintegyEVO.Core.Tests</RootNamespace>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scenery plan's file format: presentation data with no Godot in
         it, tested here because this is the solution's only test project.
         The rest of the scenery pipeline needs an engine and is watched by
         eye instead. -->
    <Compile Include="../../GodotApp/Scenery/SceneryPlan.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryCatalogue.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryEnvironment.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryFurniture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Throwaway mods' code: their own projects. -->
    <Compile Remove="ModFixtures/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StintegyEVO.Core.csproj" />
    <!-- Built so the registry tests can pack them into throwaway mods; never referenced. -->
    <ProjectReference Include="ModFixtures/alpha/alpha.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="ModFixtures/beta/beta.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- The game's own mod: its chassis for the tests that need a car on
         the road, and built into mods/official/ so the tests load the game's
         own car and circuits the way the game does. Its physics is tested
         in its own tests. -->
    <ProjectReference Include="../../mods/official/official.csproj" />
    <Compile Include="../../GodotApp/LowPoly/PresentationTiming.cs" Link="Presentation/PresentationTiming.cs" />
    <Compile Include="../../GodotApp/LowPoly/LapTimer.cs" Link="Presentation/LapTimer.cs" />
    <Compile Include="../../GodotApp/LowPoly/TrackSurfaceGeometry.cs" Link="Presentation/TrackSurfaceGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
