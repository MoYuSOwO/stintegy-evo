<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>StintegyEVO.Core.Tests</RootNamespace>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scenery plan's file format: presentation data with no Godot in
         it, tested here because this is the solution's only test project.
         The rest of the scenery pipeline needs an engine and is watched by
         eye instead. -->
    <Compile Include="../../GodotApp/Scenery/SceneryPlan.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryCatalogue.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryEnvironment.cs" />
    <Compile Include="../../GodotApp/Scenery/SceneryFurniture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StintegyEVO.Core.csproj" />
    <!-- The game's own chassis, for the tests that need a car on the road.
         Its own physics is tested in its pack. -->
    <ProjectReference Include="../../Chassis/official/single_track/single_track.csproj" />
    <!-- Built so the tests can load the game's own car the way the game does,
         from its folder under data/; never referenced. -->
    <ProjectReference Include="../../Cars/official/formula_a_mixed/formula_a_mixed.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <Compile Include="../../GodotApp/LowPoly/PresentationTiming.cs" Link="Presentation/PresentationTiming.cs" />
    <Compile Include="../../GodotApp/LowPoly/LapTimer.cs" Link="Presentation/LapTimer.cs" />
    <Compile Include="../../GodotApp/LowPoly/TrackSurfaceGeometry.cs" Link="Presentation/TrackSurfaceGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
